<?xml version="1.0" encoding="UTF-8"?>
<!-- forti-hole sync twice a day on macOS. Copy to ~/Library/LaunchAgents/ and load with
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.valkyrianlabs.forti-hole.plist
     Adjust the program path if forti-hole is not in /opt/homebrew/bin. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.valkyrianlabs.forti-hole</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/forti-hole</string>
        <string>sync</string>
        <string>--quiet</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>17</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>17</integer></dict>
    </array>
    <key>Nice</key>
    <integer>10</integer>
    <key>StandardErrorPath</key>
    <string>/tmp/forti-hole.log</string>
</dict>
</plist>
